{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "allowImportingTsExtensions": false,
    "baseUrl": ".",
    "paths": {
      "@epaper/core": ["../../packages/core/src/index.ts"],
      "@epaper/layout/src/*": ["../../packages/layout/src/*"]
    }
  },
  "include": ["src", "mock", "tests", "e2e", "e2e-ta", "vite.config.ts", "playwright.config.ts", "playwright.ta.config.ts"]
}
