  "css_extra": "\n/* ---- Tamil typography (templates/broadsheet-ta). One CSS for editor, server PDF and e-paper. ---- */\n.page,.page *{letter-spacing:0!important;font-synthesis:none}\n.page{font-weight:400;font-stretch:100%;font-variation-settings:\"wght\" 400,\"wdth\" 100;font-kerning:normal;font-variant-ligatures:common-ligatures;font-feature-settings:\"ccmp\" 1,\"locl\" 1,\"kern\" 1,\"liga\" 1;text-rendering:geometricPrecision}\n.mast .name,.strip .sec,.head{font-weight:800;font-stretch:100%;font-variation-settings:\"wght\" 800,\"wdth\" 100}\n.kicker,.sub,.strip,.mast .tag{font-weight:700;font-variation-settings:\"wght\" 700,\"wdth\" 100}\n.strip .sec{font-weight:800;font-variation-settings:\"wght\" 800,\"wdth\" 100}\n.mast .name{line-height:1.2;padding-bottom:4px}\n.mast .tag,.strip{line-height:1.6}\n.head{line-height:1.25;font-size:calc(min(17px + var(--span,2) * 4px, 42px) * var(--hs,1))}\n.kicker{font-size:19px;line-height:1.5;padding:3px 14px 3px}\n.sub{font-size:18px;line-height:1.45;margin-bottom:8px}\n.body{line-height:1.55;text-align:left}\n.body p{margin:0 0 .4em}\n.body p+p{text-indent:1.1em}\n.k-edit .kicker{font-size:24px}\n",
