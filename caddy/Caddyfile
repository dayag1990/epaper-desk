{
	admin off
}

{$APP_HOST} {
	reverse_proxy api:8100
}

{$OPS_HOST} {
	reverse_proxy ops:8101
}

{$READER_HOST} {
	reverse_proxy 127.0.0.1:8102
}

# reader + embed.js (bound to 127.0.0.1:8102 on the host); public read API goes to the api
:8102 {
	handle /healthz {
		respond `{"ok":true}` 200
	}
	handle /v1/public/* {
		reverse_proxy api:8100
	}
	# demo only: the stand-in news site, so a tapped story opens in the owner's browser
	handle_path /demo-site/* {
		reverse_proxy demo-site:8190
	}
	handle {
		root * /srv/reader
		try_files {path} /index.html
		file_server
	}
}
